# Phase 12: docker-compose reads this file (copied to ".env" in this same
# directory) to configure the postgres/backend/frontend services. Never
# commit the real ".env" - it's gitignored.
#
# Copy this file to .env, then fill in real values:
#   copy .env.example .env      (Windows)
#   cp .env.example .env         (macOS/Linux)

# --- PostgreSQL / database ---
# DB_HOST/DB_PORT are NOT set here: docker-compose.yml hardcodes DB_HOST to
# "postgres" (the compose service name) and DB_PORT to 5432 for the backend
# container - "localhost" would not reach the postgres container. DB_HOST
# and DB_PORT only need to be set explicitly when running the backend
# outside Docker (see backend/.env.example).
DB_NAME=ai_resume_analyzer
DB_USER=postgres
# Required - docker-compose has no fallback default for this on purpose.
# Generate a real local value, e.g. `openssl rand -hex 16`.
DB_PASSWORD=change_me

# Host port Postgres is published on (bound to 127.0.0.1 only). Change this
# if 5432 is already taken on your machine.
POSTGRES_PORT=5432

# --- JWT authentication ---
# Generate a real, random value, e.g. `openssl rand -hex 32`. Rotating it
# invalidates every existing access token.
JWT_SECRET_KEY=change_me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# --- Semantic matching model ---
SEMANTIC_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
SEMANTIC_SIMILARITY_THRESHOLD=0.3

# --- CORS ---
# Origin(s) the backend accepts browser requests from - must match where
# the frontend is actually served from (FRONTEND_PORT below), not the
# frontend container's internal port.
CORS_ORIGINS=http://localhost:5173

# --- Ports published to the host ---
BACKEND_PORT=8000
FRONTEND_PORT=5173

# --- Frontend build-time config ---
# Baked into the built JS bundle at "docker compose build" time (Vite env
# vars are compile-time, not runtime) - must be a URL the *browser* can
# reach, e.g. http://localhost:8000, never the Docker-internal "backend"
# hostname. Keep this in sync with BACKEND_PORT above.
VITE_API_BASE_URL=http://localhost:8000
